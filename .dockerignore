# Docker build context exclusions
# Keep image small; do not copy development artifacts

# Python
__pycache__
*.py[cod]
*.pyo
*.pyd
venv/
.env
.env.*
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Git & Dev artifacts
.git/
.gitattributes
.gitignore
.DS_Store
.cpdignore

# Project-specific
backend/.venv
backend/htmlcov
backend/.coverage
frontend/node_modules
frontend/dist
frontend/.vite

# Testing
.coverage
htmlcov/
pytestcache/
.kilo/
